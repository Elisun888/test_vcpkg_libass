{
  "version": 3,
  "configurePresets": [
    {
      "name": "android-arm64-v8a",
      "displayName": "Android ARM64 (api-21, c++_static)",
      "description": "Android ARM64 build and static C++ stdlib",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "BOTH",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "BOTH",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
        "ANDROID_NDK": "$env{ANDROID_NDK_ROOT}",
        "ANDROID_PLATFORM": "android-21",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_STL": "c++_static"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64-v8a",
      "configurePreset": "android-arm64-v8a"
    }
  ]
}
